# Primary timetable parser — Claude API (https://platform.claude.com).
# Override the model with ANTHROPIC_MODEL (default: claude-opus-4-8).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Fallback parsers, tried in order if Claude errors or returns no exams.
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase auth — protects the API so only signed-in users can call it (and
# can't burn your AI tokens). Set ONE of the following; leave both blank to run
# the API unauthenticated (a loud warning is logged each start).
#   SUPABASE_JWT_SECRET: the project's JWT secret (Supabase dashboard →
#     Project Settings → API → JWT Settings). Verifies classic HS256 tokens.
#   SUPABASE_URL: e.g. https://your-ref.supabase.co. Verifies asymmetric tokens
#     via the project's JWKS endpoint (use if you've migrated to signing keys).
# Left blank by default so local dev runs unauthenticated; set the real value in
# your host's env (Render/Vercel) to enforce it in production.
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# SUPABASE_URL=https://your-project-ref.supabase.co

# Shared secret for machine-triggered endpoints (/tasks/dispatch-reminders).
# REQUIRED in production: without it reminder dispatch is disabled (503) rather
# than left open. The Supabase pg_cron job sends this as the X-Task-Key header,
# so the value here and the one in the cron job must match.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# TASK_SECRET=your_long_random_task_secret_here

# Persistence for the reminder queue + Google OAuth tokens. Defaults to a local
# SQLite file — fine on your machine, but Render's free-tier disk is EPHEMERAL
# (wiped on every deploy/restart), which silently loses scheduled reminders and
# Google connections. In production set this to a real Postgres, e.g. the
# Supabase session-pooler URI (Dashboard -> Connect -> Session pooler):
#   postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tables are created in a private "xamio" schema, kept OFF Supabase's REST API.
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Email alerts — two options:
#
# 1) Resend HTTP API (REQUIRED on Render/most hosts, which block outbound SMTP).
#    Get a free key at https://resend.com/api-keys.
#
#    RESEND_FROM IS NOT OPTIONAL IN PRODUCTION. Left unset, sending falls back
#    to Resend's shared onboarding@resend.dev sender, which delivers ONLY to
#    your own account address. Every reminder to an actual student is rejected,
#    and because you are the one testing it, everything looks like it works.
#    Verifying a domain at https://resend.com/domains does NOT change this on
#    its own — the address here has to point at the verified domain.
#    The API logs a warning at startup if this is the state you are in.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Xamio <alerts@yourdomain.com>
#
# 2) Gmail SMTP (works locally; NOT on Render). SMTP_PASSWORD must be a 16-char
#    Gmail App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_gmail_address@gmail.com
